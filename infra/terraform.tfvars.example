# Terraform variables for TicketDesk deployment

name_prefix = "tkt-dev"
owner       = "bhumeera"
aws_region  = "us-east-1"

# CloudWatch alarm notification email
alarm_notification_email = "workdsp5@gmail.com"

# GitHub Actions OIDC repository
github_repository = "Anmol6266/ticketdesk"

# ECR images
# Replace IMAGE_TAG with the actual pushed image tag

container_image = "135274608372.dkr.ecr.us-east-1.amazonaws.com/tkt-dev-ticketdesk:IMAGE_TAG"

lambda_image = "135274608372.dkr.ecr.us-east-1.amazonaws.com/tkt-dev-thumbnail-lambda:IMAGE_TAG"

# AWS Free Tier compatible RDS backup setting
backup_retention_days = 1

# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored -
# never commit real values here even though none of these happen to be
# secret (the actual secret, the DB password, is generated by Terraform
# itself and stored in Secrets Manager, not passed in as a variable).

##name_prefix = "tkt-ab" # your initials, lowercase, e.g. tkt-jd
##owner       = "Jane Doe"
##aws_region  = "us-east-1"

# Who gets paged by the 3 CloudWatch alarms (M7). AWS emails a
# subscription-confirmation link the first time - confirm it or alarms
# fire silently.
##alarm_notification_email = "you@example.com"

# Used to scope the GitHub Actions OIDC trust policy (M6) - only this
# repo can assume the deploy role.
##github_repository = "yourteam/ticketdesk"

# Doesn't exist until after your first `terraform apply` creates the ECR
# repos and you build + push images (see infra/README.md). Point these at
# real, already-pushed tags before applying, or the ECS service/Lambda
# will spin up with nothing to run.
##container_image = "<account-id>.dkr.ecr.us-east-1.amazonaws.com/tkt-ab-ticketdesk:REPLACE_WITH_GIT_SHA"
##lambda_image     = "<account-id>.dkr.ecr.us-east-1.amazonaws.com/tkt-ab-thumbnail-lambda:REPLACE_WITH_GIT_SHA"
