# Copy to .env for local dev (python-dotenv loads it automatically - see
# src/database.py). Nothing here is required to just run `python run.py`;
# every value below has a safe local-dev default when unset.

# --- Environment -------------------------------------------------------
# dev (default) | test | prod - matches infra/variables.tf's var.environment
# exactly (infra/ecs.tf injects it verbatim into the container).
# Controls two things: whether the demo admin/agent/user accounts get
# seeded (dev/test only - never prod, src/main.py), and whether
# JWT_SECRET is required to be set explicitly (required, and fails fast
# at startup, when this is "prod" - src/security.py).
ENVIRONMENT=dev

# --- Database ------------------------------------------------------------
# Either set DATABASE_URL directly...
DATABASE_URL=sqlite:///./ticketdesk.db
# ...or, if unset, src/database.py assembles one from these (the ECS/
# production path - values come from Parameter Store + Secrets Manager,
# never typed in by hand there):
# DB_HOST=
# DB_PORT=5432
# DB_NAME=
# DB_USER=
# DB_PASSWORD=

# --- Auth ------------------------------------------------------------
# HS256 signing secret for JWTs. Leave unset for local dev - a random
# secret is generated per process instead (src/security.py), which means
# restarting the server invalidates all existing sessions. Production
# (ENVIRONMENT=production) requires this to be set explicitly - Terraform
# injects it from Secrets Manager (infra/secrets.tf) - so real user
# sessions survive a redeploy.
# JWT_SECRET=

# --- CORS ------------------------------------------------------------
# Comma-separated allowed origins for the frontend. "*" is fine for local
# dev (no cookies are used - auth is a Bearer token, not a cookie, so a
# wildcard origin doesn't carry the credential-leak risk it would with
# cookie auth). Terraform sets this to the real frontend URL in AWS.
CORS_ORIGINS=*

# --- Attachments ------------------------------------------------------
# Set to a real S3 bucket name to upload/download attachments via S3
# presigned URLs (production - infra/s3_attachments.tf). Leave unset for
# local dev: attachments then fall back to local disk under
# LOCAL_ATTACHMENTS_DIR (default ./uploads) - see
# src/routers/attachments.py.
# ATTACHMENTS_BUCKET=
# LOCAL_ATTACHMENTS_DIR=uploads

# When ATTACHMENTS_BUCKET is set, boto3 also needs AWS credentials in the
# environment (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_DEFAULT_REGION),
# or an assumed role (ECS task role in production - infra/iam.tf).
